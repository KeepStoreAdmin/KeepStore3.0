    @{ Name = 'M20_OWNER_LOAD_WITHOUT_COMPANY'; File = 'PayPalPaymentAttempts.vb'; Find = '"WHERE AttemptKey=@v AND AziendeId=@az AND LoginId=@login"'; Replace = '"WHERE AttemptKey=@v AND LoginId=@login"'; ExpectedKill = @('C09') }
    @{ Name = 'M21_FAILED_ALLOWED_FROM_AUTHORIZED'; File = 'PayPalPaymentAttempts.vb'; Find = 'New String() {PayPalPaymentAttemptStates.Creating, PayPalPaymentAttemptStates.Created}, reason, String.Empty, Nothing, "RecordFailed")'; Replace = 'New String() {PayPalPaymentAttemptStates.Creating, PayPalPaymentAttemptStates.Created, PayPalPaymentAttemptStates.Authorized}, reason, String.Empty, Nothing, "RecordFailed")'; ExpectedKill = @('T11') }
    @{ Name = 'M22_AUTHORIZATION_LOST_WITHOUT_PROOF'; File = 'PayPalPaymentAttempts.vb'; Find = 'If status <> "DENIED" AndAlso status <> "VOIDED" AndAlso status <> "EXPIRED" Then Return False'; Replace = 'If status.Length = 0 Then Return False'; ExpectedKill = @('T12') }
    @{ Name = 'M23_AUTHORIZED_WITHOUT_ORDER_BINDING'; File = 'PayPalPaymentAttempts.vb'; Find = '"RecordAuthorized", "PayPalOrderId=@order")'; Replace = '"RecordAuthorized")'; ExpectedKill = @('T05') }
    @{ Name = 'M24_TRANSITION_WITHOUT_LOGIN'; File = 'PayPalPaymentAttempts.vb'; Find = 'If loginId > 0 Then sql.Append(" AND LoginId=@login")'; Replace = '''no login filter'; ExpectedKill = @('T01') }
    @{ Name = 'M25_TRANSITION_WITHOUT_COMPANY'; File = 'PayPalPaymentAttempts.vb'; Find = 'sql.Append("Stato=@to,CurrentSlot=@slot,UltimoEsito=@esito WHERE Id=@id AND AziendeId=@az")'; Replace = 'sql.Append("Stato=@to,CurrentSlot=@slot,UltimoEsito=@esito WHERE Id=@id")'; ExpectedKill = @('T01') }
    @{ Name = 'M26_SLOT_NEVER_RELEASED'; File = 'PayPalPaymentAttempts.vb'; Find = 'If(PayPalPaymentAttemptStates.ReleasesSlot(toState), CType(DBNull.Value, Object), CType(1, Object))'; Replace = 'CType(1, Object)'; ExpectedKill = @('C06') }
    @{ Name = 'M27_BIND_IGNORES_THE_TOTAL'; File = 'PayPalPaymentAttempts.vb'; Find = 'Convert.ToInt32(reader(2), CultureInfo.InvariantCulture) <> pagamento OrElse total <> importo Then Return False'; Replace = 'Convert.ToInt32(reader(2), CultureInfo.InvariantCulture) <> pagamento Then Return False'; ExpectedKill = @('B05') }
