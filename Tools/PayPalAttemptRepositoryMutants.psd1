    @{ Name = 'M42_DRAFT_ID_NOT_VALIDATED'; File = 'PayPalPaymentAttempts.vb'; Find = 'If String.IsNullOrEmpty(r.DraftRequestId) OrElse Not KeyPattern.IsMatch(r.DraftRequestId) Then Return False'; Replace = 'If String.IsNullOrEmpty(r.DraftRequestId) Then Return False'; ExpectedKill = @('C10') }
