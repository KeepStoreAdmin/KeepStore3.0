    @{ Name = 'M34_CAPTURE_IGNORES_THE_OWNER'; File = 'PayPalPaymentAttempts.vb'; Find = 'WHERE Id=@doc AND AziendeId=@az AND UtentiId=@utenti AND PagamentiTipoId=@pagamento FOR UPDATE'; Replace = 'WHERE Id=@doc AND AziendeId=@az AND PagamentiTipoId=@pagamento FOR UPDATE'; ExpectedKill = @('K06') }
    @{ Name = 'M35_RETRY_CLAIM_WITHOUT_LEASE'; File = 'PayPalPaymentAttempts.vb'; Find = 'AND Stato=''CAPTURING'' AND UpdatedAt <= NOW() - INTERVAL @s SECOND'; Replace = 'AND Stato=''CAPTURING'''; ExpectedKill = @('K07') }
    @{ Name = 'M36_RETRY_CLAIM_FROM_ANY_STATE'; File = 'PayPalPaymentAttempts.vb'; Find = 'AND Stato=''CAPTURING'' AND UpdatedAt <= NOW() - INTERVAL @s SECOND'; Replace = 'AND UpdatedAt <= NOW() - INTERVAL @s SECOND'; ExpectedKill = @('K15') }
    @{ Name = 'M37_CAPTURE_ID_NOT_STORED'; File = 'PayPalPaymentAttempts.vb'; Find = '"PayPalCaptureId=@cap", Sub(cmd) cmd.Parameters.Add("@cap", MySqlDbType.String).Value = captureId, "RecordCaptureResult")'; Replace = 'String.Empty, Sub(cmd) cmd.Parameters.Add("@cap", MySqlDbType.String).Value = captureId, "RecordCaptureResult")'; ExpectedKill = @('K09') }
    @{ Name = 'M38_ORDER_ID_NOT_STORED'; File = 'PayPalPaymentAttempts.vb'; Find = '"PayPalOrderId=@order", Sub(cmd) cmd.Parameters.Add("@order", MySqlDbType.String).Value = orderId, "RecordOrderCreated")'; Replace = 'String.Empty, Sub(cmd) cmd.Parameters.Add("@order", MySqlDbType.String).Value = orderId, "RecordOrderCreated")'; ExpectedKill = @('A01') }
    @{ Name = 'M39_UNKNOWN_RESOLVE_UNCHECKED'; File = 'PayPalPaymentAttempts.vb'; Find = 'If Not PayPalPaymentAttemptStates.CanResolveUnknown(previous, targetState) Then Return False'; Replace = '''resolve unchecked'; ExpectedKill = @('U03') }
    @{ Name = 'M40_UNKNOWN_KEEPS_THE_PREVIOUS_STATE'; File = 'PayPalPaymentAttempts.vb'; Find = 'SET Stato=@to,StatoPrecedente=NULL,CurrentSlot=@slot,UltimoEsito=@esito WHERE Id=@id AND AziendeId=@az AND Stato=''UNKNOWN'''; Replace = 'SET Stato=@to,CurrentSlot=@slot,UltimoEsito=@esito WHERE Id=@id AND AziendeId=@az AND Stato=''UNKNOWN'''; ExpectedKill = @('U04') }
