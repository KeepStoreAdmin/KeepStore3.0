    @{ Name = 'M30_BIND_IGNORES_THE_COMPANY'; File = 'PayPalPaymentAttempts.vb'; Find = 'If Convert.ToInt32(reader(0), CultureInfo.InvariantCulture) <> aziendeId OrElse'; Replace = 'If False OrElse'; ExpectedKill = @('B04') }
    @{ Name = 'M31_BIND_DOES_NOT_STORE_THE_DOCUMENT'; File = 'PayPalPaymentAttempts.vb'; Find = 'SET Stato=''DOC_COMMITTED'',DocumentiId=@doc,StatoPrecedente=NULL'; Replace = 'SET Stato=''DOC_COMMITTED'',DocumentiId=NULL,StatoPrecedente=NULL'; ExpectedKill = @('B01') }
