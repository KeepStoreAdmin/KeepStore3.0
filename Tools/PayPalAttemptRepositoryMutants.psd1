    @{ Name = 'M46_STUCK_LIST_INCLUDES_FINALS'; File = 'PayPalPaymentAttempts.vb'; Find = 'Stato NOT IN (''COMPLETED'',''VOIDED'',''FAILED'',''CANCELED'',''CAPTURED_ORPHAN'')'; Replace = 'Stato NOT IN (''COMPLETED'')'; ExpectedKill = @('L01') }
