# PAYPAL-ATTEMPTS-TABLE-1A: mutanti del repository, della macchina a stati e dello script SQL (File = 'DOCS': copia del forward della pagina docs).
# ExpectedKill = prefissi del PRIMO controllo del harness che deve cadere (il harness si ferma al primo FAIL: un altro controllo non conta).
# Mutanti di sola ridondanza (difesa in profondita: guardia di stato nell'UPDATE oltre al FOR UPDATE, filtro della macchina a stati oltre agli elenchi di partenza) sono equivalenti e non compaiono.
@{ Mutants = @(
    @{ Name = 'M01_CREATING_CAN_COMPLETE'; File = 'PayPalPaymentAttemptStates.vb'; Find = 'Return IsAnyOf(toState, Created, Failed, Unknown)'; Replace = 'Return IsAnyOf(toState, Created, Failed, Unknown, Completed)'; ExpectedKill = @('S02') }
    @{ Name = 'M02_AUTHORIZED_CANNOT_FAIL'; File = 'PayPalPaymentAttemptStates.vb'; Find = 'Return IsAnyOf(toState, DocCommitted, Voiding, Failed, CapturedOrphan, Unknown)'; Replace = 'Return IsAnyOf(toState, DocCommitted, Voiding, CapturedOrphan, Unknown)'; ExpectedKill = @('S02') }
    @{ Name = 'M03_REFUSED_CANNOT_VOID'; File = 'PayPalPaymentAttemptStates.vb'; Find = 'Return IsAnyOf(toState, Completed, Voiding)'; Replace = 'Return IsAnyOf(toState, Completed)'; ExpectedKill = @('S02') }
    @{ Name = 'M04_RELEASED_STATES_REOPEN'; File = 'PayPalPaymentAttemptStates.vb'; Find = 'Return toState = CapturedOrphan'; Replace = 'Return toState = CapturedOrphan OrElse toState = Created'; ExpectedKill = @('S02') }
    @{ Name = 'M05_UNKNOWN_HAS_A_DIRECT_EXIT'; File = 'PayPalPaymentAttemptStates.vb'; Find = 'Case Voided, Failed, Canceled'; Replace = 'Case Voided, Failed, Canceled, Unknown'; ExpectedKill = @('S02') }
    @{ Name = 'M06_RESOLVE_CAN_BIND_DOCUMENT'; File = 'PayPalPaymentAttemptStates.vb'; Find = 'If target = DocCommitted Then Return False'; Replace = 'If False Then Return False'; ExpectedKill = @('S04') }
    @{ Name = 'M07_RESOLVE_AUTHORIZED_TO_FAILED'; File = 'PayPalPaymentAttemptStates.vb'; Find = 'If previousState = Authorized AndAlso target = Failed Then Return False'; Replace = 'If False Then Return False'; ExpectedKill = @('S04') }
    @{ Name = 'M08_RESOLVE_TO_UNKNOWN'; File = 'PayPalPaymentAttemptStates.vb'; Find = 'If target = Unknown OrElse Not IsKnown(target) Then Return False'; Replace = 'If Not IsKnown(target) Then Return False'; ExpectedKill = @('S04') }
    @{ Name = 'M09_COMPLETED_RELEASES_THE_SLOT'; File = 'PayPalPaymentAttemptStates.vb'; Find = 'Return IsAnyOf(state, Failed, Canceled, Voided, CapturedOrphan)'; Replace = 'Return IsAnyOf(state, Failed, Canceled, Voided, CapturedOrphan, Completed)'; ExpectedKill = @('S05') }
    @{ Name = 'M10_ORPHAN_HAS_AN_EXIT'; File = 'PayPalPaymentAttemptStates.vb'; Find = 'Return IsAnyOf(state, Completed, CapturedOrphan)'; Replace = 'Return IsAnyOf(state, Completed)'; ExpectedKill = @('S06') }
    @{ Name = 'M11_CREATING_FAILS_TOO_EARLY'; File = 'PayPalPaymentAttemptStates.vb'; Find = 'If ageMinutes >= 10 Then Return If(hasOrderId, "READ_ORDER_THEN_DECIDE", "FAIL_NO_ORDER")'; Replace = 'If ageMinutes >= 1 Then Return If(hasOrderId, "READ_ORDER_THEN_DECIDE", "FAIL_NO_ORDER")'; ExpectedKill = @('S07') }
    @{ Name = 'M12_CREATED_CANCELED_WITHOUT_READING'; File = 'PayPalPaymentAttemptStates.vb'; Find = 'If ageMinutes >= 30 Then Return "READ_ORDER_THEN_DECIDE"'; Replace = 'If ageMinutes >= 30 Then Return "CANCEL_ORDER"'; ExpectedKill = @('S08') }
    @{ Name = 'M13_LIVE_DRAFT_VOIDED'; File = 'PayPalPaymentAttemptStates.vb'; Find = 'If draftExpired Then Return "VOID_EXPIRED_DRAFT"'; Replace = 'If True Then Return "VOID_EXPIRED_DRAFT"'; ExpectedKill = @('S09') }
    @{ Name = 'M14_UNKNOWN_IGNORED'; File = 'PayPalPaymentAttemptStates.vb'; Find = 'Return "READ_PAYPAL_RESOLVE"'; Replace = 'Return "NONE"'; ExpectedKill = @('S10') }
    @{ Name = 'M15_CHANGED_FINGERPRINT_RESUMES'; File = 'PayPalPaymentAttempts.vb'; Find = 'Dim same As Boolean = String.Equals(live.PayloadFingerprint, request.PayloadFingerprint, StringComparison.Ordinal) AndAlso live.PagamentiTipoId = request.PagamentiTipoId'; Replace = 'Dim same As Boolean = True'; ExpectedKill = @('C04') }
    @{ Name = 'M16_LIVE_ATTEMPT_OF_ANOTHER_LOGIN'; File = 'PayPalPaymentAttempts.vb'; Find = 'WHERE AziendeId=@az AND LoginId=@login AND DraftRequestId=@draft AND CurrentSlot=1 LIMIT 1'; Replace = 'WHERE AziendeId=@az AND DraftRequestId=@draft AND CurrentSlot=1 LIMIT 1'; ExpectedKill = @('C05') }
    @{ Name = 'M17_NO_RETRY_ON_DUPLICATE'; File = 'PayPalPaymentAttempts.vb'; Find = 'Catch ex As MySqlException When ex.Number = 1062 OrElse ex.Number = 1213 OrElse ex.Number = 1205'; Replace = 'Catch ex As MySqlException When ex.Number = 99999'; ExpectedKill = @('P01') }
    @{ Name = 'M18_ATTEMPT_NUMBER_NEVER_GROWS'; File = 'PayPalPaymentAttempts.vb'; Find = 'SELECT COALESCE(MAX(TentativoNo),0)+1 FROM'; Replace = 'SELECT COALESCE(MAX(TentativoNo),0)*0+1 FROM'; ExpectedKill = @('C07') }
