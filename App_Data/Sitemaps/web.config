<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- Defense-in-depth: deny any request to this folder.
         Note: App_Data is already not served by ASP.NET, but this prevents
         accidental exposure if paths change. -->
    <authorization>
      <deny users="*" />
    </authorization>
  </system.web>
</configuration>
