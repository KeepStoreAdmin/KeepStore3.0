<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Hard block: questa cartella contiene file cache generati (sitemap XML, ecc.)
    Non deve essere navigabile/servibile via web.

    Nota: App_Data è già un "hidden segment" e IIS/ASP.NET lo blocca di default,
    ma questo aggiunge una protezione ulteriore e soprattutto evita configurazioni
    IIS (handlers/modules) che possono dare errori 500.19 su alcune installazioni.
  -->
  <system.web>
    <authorization>
      <deny users="*" />
    </authorization>
  </system.web>
</configuration>
