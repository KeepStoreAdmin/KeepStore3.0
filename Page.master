<%@ Master Language="VB" AutoEventWireup="false" CodeFile="Page.master.vb" Inherits="PageMaster" %>
<%@ Register Src="~/Public/ui/controls/SiteHeader.ascx" TagPrefix="ks" TagName="SiteHeader" %>
<%@ Register Src="~/Public/ui/controls/SiteFooter.ascx" TagPrefix="ks" TagName="SiteFooter" %>

<!DOCTYPE html>
<html lang="it">
<head runat="server">
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server" /></title>

    <!-- ============================================================
         Core assets (tema grafico)
         Base path: /Public/assets/keepstore/
         ============================================================ -->
    <link rel="stylesheet" href="<%= ThemeManager.Asset("fonts/font.css") %>" />
    <link rel="stylesheet" href="<%= ThemeManager.Asset("icons/icomoon/style.css") %>" />

    <link rel="stylesheet" href="<%= ThemeManager.Asset("css/bootstrap.min.css") %>" />
    <link rel="stylesheet" href="<%= ThemeManager.Asset("css/nice-select.css") %>" />
    <link rel="stylesheet" href="<%= ThemeManager.Asset("css/swiper-bundle.min.css") %>" />
    <link rel="stylesheet" href="<%= ThemeManager.Asset("css/animate.css") %>" />
    <link rel="stylesheet" href="<%= ThemeManager.Asset("css/styles.css") %>" />

    <!-- SEO / JSON-LD injection -->
    <asp:PlaceHolder ID="phSeoJsonLd" runat="server" Visible="false">
        <script type="application/ld+json"><asp:Literal ID="litSeoJsonLd" runat="server" EnableViewState="False" /></script>
    </asp:PlaceHolder>

    <!-- SEO globale (robots/canonical) - injected by Page.master.vb -->
    <asp:Literal ID="litGlobalSeoHead" runat="server" EnableViewState="False" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />

    <!-- Override / bridge CSS (ordine: base -> override tema -> bridge legacy -> custom per pagine) -->
    <link rel="stylesheet" href="<%= ThemeManager.Asset("css/theme-overrides.css") %>" />
    <link rel="stylesheet" href="<%= ThemeManager.Asset("css/keepstore-overrides.css") %>" />
    <link rel="stylesheet" href="<%= ThemeManager.Asset("css/keepstore.css") %>" />

</head>

<body id="PageBody" runat="server">
<form id="form1" runat="server">

        <!-- Scroll Top -->
        <button id="goTop" type="button" aria-label="Torna su">
            <span class="border-progress"></span>
            <span class="icon icon-arrow-right"></span>
        </button>

        <!-- Preload -->
        <div class="preload preload-container" id="preload" aria-hidden="true">
            <div class="preload-logo">
                <div class="spinner"></div>
            </div>
        </div>


        <!-- ============================================================
             Global: Facebook Like popup placeholder (legacy)
             NOTE: controllato dal code-behind (PopUpfacebook.Visible)
             ============================================================ -->
        <asp:Panel ID="PopUpfacebook" runat="server" Visible="False">
            <div class="modal fade show" style="display:block; background: rgba(0,0,0,.55);" role="dialog" aria-modal="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Seguici su Facebook</h5>
                        </div>
                        <div class="modal-body">
                            <p class="mb-0">Metti “Mi piace” alla nostra pagina per restare aggiornato su offerte e novità.</p>
                        </div>
                        <div class="modal-footer">
                            <asp:LinkButton ID="LB_CancelFacebook" runat="server" CssClass="btn btn-primary" Text="Chiudi" CausesValidation="False" />
                        </div>
                    </div>
                </div>
            </div>
        </asp:Panel>

        <div id="wrapper">

                        <!-- ============================================================
                 HEADER (UI contract)
                 ============================================================ -->
            <asp:ContentPlaceHolder ID="HeaderContent" runat="server">
                <ks:SiteHeader ID="SiteHeader1" runat="server" />
            </asp:ContentPlaceHolder>



            <!-- Main Content -->
            <main>
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />

                <!-- Legacy aliases -->
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
                <asp:ContentPlaceHolder ID="cph" runat="server" />
            </main>

                        <!-- ============================================================
                 FOOTER (UI contract)
                 ============================================================ -->
            <asp:ContentPlaceHolder ID="FooterContent" runat="server">
                <ks:SiteFooter ID="SiteFooter1" runat="server" />
            </asp:ContentPlaceHolder>


        </div><!-- /#wrapper -->

        <!-- DataSources (legacy, required by Page.master.vb) -->
        <asp:SqlDataSource ID="SqlData_Popup" runat="server"
            ConnectionString="<%$ ConnectionStrings:EntropicConnectionString %>"
            ProviderName="<%$ ConnectionStrings:EntropicConnectionString.ProviderName %>" />

        <asp:SqlDataSource ID="SqlData_TotOrdini" runat="server"
            ConnectionString="<%$ ConnectionStrings:EntropicConnectionString %>"
            ProviderName="<%$ ConnectionStrings:EntropicConnectionString.ProviderName %>" />

        <asp:SqlDataSource ID="Sql_Partners" runat="server"
            ConnectionString="<%$ ConnectionStrings:EntropicConnectionString %>"
            ProviderName="<%$ ConnectionStrings:EntropicConnectionString.ProviderName %>" />

        <asp:SqlDataSource ID="SqlDataFooterDIV1" runat="server"
            ConnectionString="<%$ ConnectionStrings:EntropicConnectionString %>"
            ProviderName="<%$ ConnectionStrings:EntropicConnectionString.ProviderName %>" />

        <asp:SqlDataSource ID="SqlDataFooterDIV2" runat="server"
            ConnectionString="<%$ ConnectionStrings:EntropicConnectionString %>"
            ProviderName="<%$ ConnectionStrings:EntropicConnectionString.ProviderName %>" />

        <asp:SqlDataSource ID="SqlDataFooterDIV3" runat="server"
            ConnectionString="<%$ ConnectionStrings:EntropicConnectionString %>"
            ProviderName="<%$ ConnectionStrings:EntropicConnectionString.ProviderName %>" />

        <asp:SqlDataSource ID="SqlDataFooterDIV4" runat="server"
            ConnectionString="<%$ ConnectionStrings:EntropicConnectionString %>"
            ProviderName="<%$ ConnectionStrings:EntropicConnectionString.ProviderName %>" />

		<!-- JS (tutto da /Public/assets/keepstore/) -->
		<script src="<%= ThemeManager.Asset("js/jquery.min.js") %>"></script>
		<script src="<%= ThemeManager.Asset("js/bootstrap.min.js") %>"></script>
		<script src="<%= ThemeManager.Asset("js/bootstrap-select.min.js") %>"></script>
		<script src="<%= ThemeManager.Asset("js/jquery.nice-select.js") %>"></script>
		<script src="<%= ThemeManager.Asset("js/swiper-bundle.min.js") %>"></script>
		<script src="<%= ThemeManager.Asset("js/carousel.js") %>"></script>
		<script src="<%= ThemeManager.Asset("js/wow.min.js") %>"></script>
		<script src="<%= ThemeManager.Asset("js/infinityslide.js") %>"></script>
		<script src="<%= ThemeManager.Asset("js/multiple-modal.js") %>"></script>
		<script src="<%= ThemeManager.Asset("js/lazysize.min.js") %>"></script>
		<script src="<%= ThemeManager.Asset("js/shop.js") %>"></script>
		<script src="<%= ThemeManager.Asset("js/main.js") %>"></script>
		<script src="<%= ThemeManager.Asset("js/sibforms.js") %>"></script>
		<script src="<%= ThemeManager.Asset("js/drift.min.js") %>"></script>

		<!-- Script specifici pagina (es. zoom.js su articolo.aspx) -->
		<asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />

    </form>
</body>
</html>