<%@ Master Language="VB" AutoEventWireup="false" CodeFile="Page.master.vb" Inherits="PageMaster" %>

<!DOCTYPE html>
<html lang="it">
<head runat="server">
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server" /></title>

    <!-- ============================================================
         ONus (core assets)
         NOTE: i file CSS sono in /Public/assets/css
         ============================================================ -->
    <link rel="stylesheet" href="<%= ThemeManager.Asset("fonts/font.css") %>" />
    <link rel="stylesheet" href="<%= ThemeManager.Asset("icons/icomoon/style.css") %>" />

    <link rel="stylesheet" href="<%= ThemeManager.Asset("css/bootstrap.min.css") %>" />
    <link rel="stylesheet" href="<%= ThemeManager.Asset("css/nice-select.css") %>" />
    <link rel="stylesheet" href="<%= ThemeManager.Asset("css/swiper-bundle.min.css") %>" />
    <link rel="stylesheet" href="<%= ThemeManager.Asset("css/animate.css") %>" />
    <link rel="stylesheet" href="<%= ThemeManager.Asset("css/styles.css") %>" />

    <!-- SEO / JSON-LD injection -->
    <asp:PlaceHolder ID="phSeoJsonLd" runat="server" Visible="false">
        <script type="application/ld+json"><asp:Literal ID="litSeoJsonLd" runat="server" EnableViewState="False" /></script>
    </asp:PlaceHolder>

    <!-- SEO globale (robots/canonical) - injected by Page.master.vb -->
    <asp:Literal ID="litGlobalSeoHead" runat="server" EnableViewState="False" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />

    <!-- ONSUS CSS -->
    <link rel="stylesheet" href="/Public/assets/keepstore/icon/icomoon/style.css" />
    <link rel="stylesheet" href="/Public/assets/keepstore/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/Public/assets/keepstore/css/animate.css" />
    <link rel="stylesheet" href="/Public/assets/keepstore/css/swiper-bundle.min.css" />
    <link rel="stylesheet" href="/Public/assets/keepstore/css/select2.min.css" />
    <link rel="stylesheet" href="/Public/assets/keepstore/css/main.css" />
    <link rel="stylesheet" href="/Public/assets/keepstore/css/taikun-onsus-overrides.css" />

</head>

<body id="PageBody" runat="server" class="preload-wrapper popup-loader">
    <form id="form1" runat="server">

        <!-- ============================================================
             Global: Facebook Like popup placeholder (legacy)
             NOTE: controllato dal code-behind (PopUpfacebook.Visible)
             ============================================================ -->
        <asp:Panel ID="PopUpfacebook" runat="server" Visible="False">
            <div class="modal fade show" style="display:block; background: rgba(0,0,0,.55);" role="dialog" aria-modal="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Seguici su Facebook</h5>
                        </div>
                        <div class="modal-body">
                            <p class="mb-0">Metti “Mi piace” alla nostra pagina per restare aggiornato su offerte e novità.</p>
                        </div>
                        <div class="modal-footer">
                            <asp:LinkButton ID="LB_CancelFacebook" runat="server" CssClass="btn btn-primary" Text="Chiudi" CausesValidation="False" />
                        </div>
                    </div>
                </div>
            </div>
        </asp:Panel>

        <div id="wrapper">

            <!-- ============================================================
                 HEADER (migrazione ONus)
                 - Mantiene ID/handler esistenti (imgLogo/imgLogoMobile, tbCerca, btnSearch, mvLogin, rptNavSettori, lblCarrelloCount/lblCarrelloTotale)
                 ============================================================ -->
            <header class="tf-header style-2">
<div class="inner-header">
<div class="container">
<div class="row">
<div class="col-md-3 col-7 d-flex align-items-center">
<div class="logo-site">
<a href="Default.aspx">
<img alt="Logo" class="lazyload" decoding="async" height="128" sizes="(max-width: 328px) 100vw, 328px" src="/Public/assets/keepstore/images/logo/logo.webp" srcset="/Public/assets/keepstore/images/logo/logo.webp 328w" width="578"/>
</a>
</div>
</div>
<div class="col-md-6 d-none d-md-block">
<div class="header-center justify-content-end">
<form class="form-search-product style-2">
<div class="select-category">
<select class="dropdown_product_cat" id="product_cat" name="product_cat">
<option selected="selected" value="">All categories</option>
<option class="level-0" value="apple-products">Apple products</option>
<option class="level-0" value="audio-equipments">Audio Equipments</option>
<option class="level-0" value="camera-video">Camera &amp; Video</option>
<option class="level-0" value="game-room-furniture">Game &amp; Room Furniture
                                            </option>
<option class="level-0" value="gaming-accessories">Gaming Accessories
                                            </option>
<option class="level-0" value="headphone">Headphone</option>
<option class="level-0" value="laptop-tablet">Laptop &amp; Tablet</option>
<option class="level-0" value="server-workstation">Server &amp; Workstation
                                            </option>
<option class="level-0" value="smartphone">Smartphone</option>
<option class="level-0" value="smartwatch">Smartwatch</option>
<option class="level-0" value="storage-digital-devices">Storage &amp; Digital
                                                Devices</option>
<option class="level-0" value="tv-computer-screen">TV &amp; Computer Screen
                                            </option>
</select>
<ul class="select-options">
<li class="link" rel=""><span>All categories</span></li>
<li class="link" rel="apple-products"><span>Apple products</span> </li>
<li class="link" rel="audio-equipments"><span>Audio Equipments</span></li>
<li class="link" rel="camera-video"><span>Camera &amp; Video</span></li>
<li class="link" rel="game-room-furniture"><span>Game &amp; Room
                                                    Furniture</span></li>
<li class="link" rel="gaming-accessories"><span>Gaming Accessories</span>
</li>
<li class="link" rel="headphone"><span>Headphone</span></li>
<li class="link" rel="laptop-tablet"><span>Laptop &amp; Tablet</span></li>
<li class="link" rel="server-workstation"><span>Server &amp; Workstation</span>
</li>
<li class="link" rel="smartphone"><span>Smartphone</span></li>
<li class="link" rel="smartwatch"><span>Smartwatch</span></li>
<li class="link" rel="storage-digital-devices"><span>Storage &amp; Digital
                                                    Devices</span></li>
<li class="link" rel="tv-computer-screen"><span>TV &amp; Computer Screen</span>
</li>
</ul>
</div>
<span class="br-line type-vertical bg-line"></span>
<fieldset>
<input placeholder="Search for products" type="text"/>
</fieldset>
<button class="btn-submit-form" type="submit">
<i class="icon-search"></i>
</button>
</form>
</div>
</div>
<div class="col-md-3 col-5 d-flex align-items-center justify-content-end">
<div class="header-right">
<div class="support-wrap d-none d-xl-flex">
<img alt="" class="flex-shrink-0" src="icons/headphone-2.svg" style="height: 44px; width: 44px;"/>
<div class="content">
<p class="call-us body-text-3">
