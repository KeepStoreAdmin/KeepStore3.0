<%@ Control Language="VB" AutoEventWireup="false" CodeFile="HomeIconBoxes.ascx.vb" Inherits="UI_HomeIconBoxes" %>
<div class="tf-sp-2 pt-0">
    <div class="container">
        <div class="swiper tf-sw-iconbox" data-preview="4" data-tablet="2" data-mobile-sm="2" data-mobile="1" data-space-lg="20" data-space-md="20" data-space="15">
            <div class="swiper-wrapper">
                <div class="swiper-slide">
                    <div class="tf-icon-box wow fadeInLeft" data-wow-delay="0">
                        <div class="icon-box"><i class="icon icon-tool"></i></div>
                        <div class="content">
                            <p class="body-text fw-semibold" data-ks-i18n="icon.techSupport">Assistenza tecnica specializzata</p>
                            <p class="body-text-3" data-ks-i18n="icon.techSupportText">Supporto su PC, smartphone, reti e periferiche</p>
                        </div>
                    </div>
                </div>
                <div class="swiper-slide">
                    <div class="tf-icon-box wow fadeInLeft" data-wow-delay="0.1s">
                        <div class="icon-box"><i class="icon icon-delivery-2"></i></div>
                        <div class="content">
                            <p class="body-text fw-semibold" data-ks-i18n="icon.pickupDelivery">Ritiro in negozio / spedizione</p>
                            <p class="body-text-3" data-ks-i18n="icon.pickupDeliveryText">Scegli la soluzione piu comoda per il tuo ordine</p>
                        </div>
                    </div>
                </div>
                <div class="swiper-slide">
                    <div class="tf-icon-box wow fadeInLeft" data-wow-delay="0.2s">
                        <div class="icon-box"><i class="icon icon-check-3"></i></div>
                        <div class="content">
                            <p class="body-text fw-semibold" data-ks-i18n="icon.selectedProducts">Prodotti selezionati</p>
                            <p class="body-text-3" data-ks-i18n="icon.selectedProductsText">Catalogo tech curato e disponibilita controllate</p>
                        </div>
                    </div>
                </div>
                <div class="swiper-slide">
                    <div class="tf-icon-box wow fadeInLeft" data-wow-delay="0.3s">
                        <div class="icon-box"><i class="icon icon-support-2"></i></div>
                        <div class="content">
                            <p class="body-text fw-semibold" data-ks-i18n="icon.afterSales">Supporto post-vendita</p>
                            <p class="body-text-3" data-ks-i18n="icon.afterSalesText">Restiamo disponibili anche dopo l'acquisto</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="sw-pagination-iconbox sw-dot-default justify-content-center"></div>
        </div>
    </div>
</div>
